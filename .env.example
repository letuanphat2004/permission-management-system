# Sao chép file này thành .env trước khi chạy Docker Compose.
MYSQL_DATABASE=window_authorizer
MYSQL_ROOT_PASSWORD=change-this-root-password
DB_USERNAME=window_app
DB_PASSWORD=change-this-app-password

APP_PORT=8080
MYSQL_PORT=3307
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
UPLOAD_MAX_FILE_SIZE=200MB
UPLOAD_MAX_REQUEST_SIZE=220MB
